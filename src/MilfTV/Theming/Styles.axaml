<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <CornerRadius x:Key="CardRadius">14</CornerRadius>
    <CornerRadius x:Key="PosterRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>
    <x:Double x:Key="ScrollBarSize">10</x:Double>

    <!-- Ascenseurs de toute l'application (vertical et horizontal) : 16 px de zone de prise, piste fine et
         poignée « pilule » à la couleur d'accent, qui s'épaississent au survol. Pas de flèches aux extrémités
         (les rangées horizontales ont leurs propres flèches, Controls/Rail). Appliqué par le style « ScrollBar ». -->
    <ControlTheme x:Key="AppScrollThumb" TargetType="Thumb">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <ThicknessTransition Property="Padding" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <Border Margin="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="AppScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="AppScrollBar" TargetType="ScrollBar">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Background="Transparent">
            <Border Name="AppTrack" CornerRadius="4" Background="{DynamicResource BorderSubtle}">
              <Border.Transitions>
                <Transitions>
                  <ThicknessTransition Property="Margin" Duration="0:0:0.12" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <Track Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"
                   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource AppScrollPage}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource AppScrollPage}" />
              </Track.IncreaseButton>
              <Thumb Name="AppThumb" Theme="{StaticResource AppScrollThumb}" />
            </Track>
          </Panel>
        </ControlTemplate>
      </Setter>
      <!-- Horizontal -->
      <Style Selector="^:horizontal">
        <Setter Property="Height" Value="16" />
      </Style>
      <Style Selector="^:horizontal /template/ Border#AppTrack">
        <Setter Property="Margin" Value="0,6" />
      </Style>
      <Style Selector="^:horizontal /template/ Thumb#AppThumb">
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="MinWidth" Value="48" />
      </Style>
      <Style Selector="^:horizontal:pointerover /template/ Border#AppTrack">
        <Setter Property="Margin" Value="0,4" />
      </Style>
      <Style Selector="^:horizontal:pointerover /template/ Thumb#AppThumb">
        <Setter Property="Padding" Value="0,2" />
      </Style>
      <!-- Vertical -->
      <!-- Vertical : zone de prise de 12 px (posée sur le bord droit du contenu, elle en couvre moins) -->
      <Style Selector="^:vertical">
        <Setter Property="Width" Value="12" />
      </Style>
      <!-- Valeur croissante vers le bas, comme le thème Fluent -->
      <Style Selector="^:vertical /template/ Track#PART_Track">
        <Setter Property="IsDirectionReversed" Value="True" />
      </Style>
      <Style Selector="^:vertical /template/ Border#AppTrack">
        <Setter Property="Margin" Value="4,0" />
      </Style>
      <Style Selector="^:vertical /template/ Thumb#AppThumb">
        <Setter Property="Padding" Value="3,0" />
        <Setter Property="MinHeight" Value="48" />
      </Style>
      <Style Selector="^:vertical:pointerover /template/ Border#AppTrack">
        <Setter Property="Margin" Value="3,0" />
      </Style>
      <Style Selector="^:vertical:pointerover /template/ Thumb#AppThumb">
        <Setter Property="Padding" Value="1,0" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#AppTrack">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <!-- ───────── Typographie ───────── -->
  <Style Selector="TextBlock.icon">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="40" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- ───────── Indicateur de chargement ───────── -->
  <Style Selector="Arc.spinner">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Stroke" Value="{DynamicResource Accent}" />
    <Setter Property="StrokeThickness" Value="3.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StartAngle" Value="0" />
    <Setter Property="SweepAngle" Value="260" />
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Arc.spinner.small">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>
  <Style Selector="Arc.spinner.white">
    <Setter Property="Stroke" Value="White" />
  </Style>

  <!-- ───────── Conteneurs ───────── -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource AppBgAlt}" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Background" Value="{DynamicResource SurfaceActive}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <!-- Badge avec icône : texte dans un StackPanel -->
  <Style Selector="Border.badge > StackPanel > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Border.badge > StackPanel > TextBlock.icon">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Border.badge.live">
    <Setter Property="Background" Value="{DynamicResource Live}" />
  </Style>
  <Style Selector="Border.badge.live > TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Border.badge.accent">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Border.badge.accent > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>

  <!-- ───────── Boutons ───────── -->
  <Style Selector="Button, ToggleButton, RepeatButton">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.flat, ToggleButton.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.flat:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.flat:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceActive}" />
  </Style>
  <Style Selector="ToggleButton.flat:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceActive}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>

  <Style Selector="Button.soft, ToggleButton.soft">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Button.soft:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.soft:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.soft:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.soft:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceActive}" />
  </Style>
  <Style Selector="ToggleButton.soft:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,8" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Danger}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
  </Style>

  <!-- Bouton rond d'icône -->
  <Style Selector="Button.icon, ToggleButton.icon">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="19" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceActive}" />
  </Style>
  <Style Selector="Button.icon:disabled">
    <Setter Property="Opacity" Value="0.28" />
  </Style>

  <!-- Fiches : pastilles techniques (4K, HDR, 5.1…) et cases « Informations sur le média » -->
  <Style Selector="Border.mediaChip">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
  </Style>
  <Style Selector="Border.mediaChip TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Border.mediaChip.small">
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="Border.mediaChip.small TextBlock">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Border.mediaTile">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="MinWidth" Value="170" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
  </Style>

  <!-- Flèches des rangées horizontales (Controls/Rail) : par-dessus les affiches, lisibles dans les deux thèmes -->
  <Style Selector="Button.railArrow">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="46" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="23" />
    <Setter Property="Background" Value="#D9141418" />
    <Setter Property="BorderBrush" Value="#40FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.railArrow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.railArrow:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
  </Style>
  <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- Boutons sur la vidéo (toujours clairs) -->
  <Style Selector="Button.osd, ToggleButton.osd">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.osd:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.osd:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#33FFFFFF" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.osd:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.osd:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#55FFFFFF" />
  </Style>
  <Style Selector="ToggleButton.osd:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#40FFFFFF" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.osd TextBlock.icon, ToggleButton.osd TextBlock.icon">
    <Setter Property="FontSize" Value="18" />
  </Style>
  <Style Selector="Button.osd.big">
    <Setter Property="Width" Value="60" />
    <Setter Property="Height" Value="60" />
    <Setter Property="CornerRadius" Value="30" />
    <Setter Property="Background" Value="#26FFFFFF" />
  </Style>
  <Style Selector="Button.osd.big TextBlock.icon">
    <Setter Property="FontSize" Value="24" />
  </Style>
  <Style Selector="Button.osdText">
    <Setter Property="Background" Value="#26FFFFFF" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.osdText:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#44FFFFFF" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Navigation latérale -->
  <Style Selector="Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.nav.active TextBlock.icon">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- Puces (filtres, saisons…) -->
  <Style Selector="ToggleButton.chip, RadioButton.chip">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="RadioButton.chip">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.chip:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  </Style>
  <Style Selector="RadioButton.chip:checked">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="RadioButton.chip:checked /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!-- ───────── Listes ───────── -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.clean > ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.clean > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="ListBox.clean > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
  </Style>
  <Style Selector="ListBox.clean > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector="ListBox.clean > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector="ListBox.clean > ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>

  <!-- ───────── Champs ───────── -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="TextBox.search">
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="40,8,14,8" />
    <Setter Property="MinHeight" Value="40" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="MinHeight" Value="38" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="ProgressBar.thin">
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="Height" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="Height" Value="1" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>
  <!-- Tous les ascenseurs : thème AppScrollBar (voir les ressources en tête de fichier). -->
  <Style Selector="ScrollBar">
    <Setter Property="Theme" Value="{StaticResource AppScrollBar}" />
  </Style>

  <!-- Survol des cartes d'affiche -->
  <Style Selector="Border.poster">
    <Setter Property="CornerRadius" Value="{StaticResource PosterRadius}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{DynamicResource Placeholder}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.cardButton:pointerover Border.poster">
    <Setter Property="RenderTransform" Value="scale(1.035)" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Border.poster Border.hoverPlay">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.cardButton:pointerover Border.hoverPlay">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button.cardButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.cardButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.cardButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.cardButton:pressed">
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>
  <!-- Menu du profil (bas de la barre latérale) -->
  <Style Selector="FlyoutPresenter.profileMenu">
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MaxWidth" Value="420" />
  </Style>
</Styles>
