<UserControl xmlns:l="using:MilfTV.Localization"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MilfTV.ViewModels"
             xmlns:core="using:MilfTV.Core"
             xmlns:ctl="using:MilfTV.Controls"
             xmlns:img="using:MilfTV.Images"
             x:Class="MilfTV.Views.SeriesDetailView"
             x:DataType="vm:SeriesDetailViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox.seasons > ListBoxItem">
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.seasons > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="18" />
    </Style>
    <Style Selector="ListBox.seasons > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    </Style>
    <Style Selector="ListBox.seasons > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Border.episode">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Button.cardButton:pointerover Border.episode">
      <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <Panel VerticalAlignment="Top" Height="560" ClipToBounds="True">
      <Image img:ImageLoader.Source="{Binding Poster}" img:ImageLoader.DecodeWidth="300" Stretch="UniformToFill" Opacity="0.35">
        <Image.Effect><BlurEffect Radius="60" /></Image.Effect>
      </Image>
      <Image img:ImageLoader.Source="{Binding Backdrop}" img:ImageLoader.DecodeWidth="1600" Stretch="UniformToFill" Opacity="0.6" />
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="{DynamicResource AppBgColor}" Offset="1" />
            <GradientStop Color="{DynamicResource AppBgClearColor}" Offset="0.2" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="{DynamicResource AppBgColor}" Offset="0" />
            <GradientStop Color="{DynamicResource AppBgClearColor}" Offset="0.7" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Panel>

    <ScrollViewer>
      <StackPanel Margin="40,8,40,40" Spacing="28">
        <Button Classes="flat" Command="{Binding BackCommand}" HorizontalAlignment="Left" Padding="10,6" Margin="-10,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon" Text="&#xE72B;" FontSize="13" />
            <TextBlock Text="{l:Tr Ui.Retour}" />
          </StackPanel>
        </Button>

        <Grid ColumnDefinitions="230,*">
          <Border Width="230" Height="345" CornerRadius="18" ClipToBounds="True" Background="{DynamicResource Placeholder}" BoxShadow="0 24 60 0 #77000000" VerticalAlignment="Top">
            <Panel>
              <TextBlock Text="{Binding Series.Initials}" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource PlaceholderText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image img:ImageLoader.Source="{Binding Poster}" img:ImageLoader.DecodeWidth="460" Stretch="UniformToFill" />
            </Panel>
          </Border>
          <StackPanel Grid.Column="1" Margin="40,6,0,0" Spacing="14">
            <TextBlock Classes="display" Text="{Binding DisplayTitle}" TextWrapping="Wrap" />
            <WrapPanel Orientation="Horizontal">
              <Border Classes="badge" Background="#33FFD24D" Margin="0,0,10,6" IsVisible="{Binding RatingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding RatingText, StringFormat='★ {0}'}" Foreground="#FFC43D" />
              </Border>
              <Border Classes="badge" Margin="0,0,10,6" IsVisible="{Binding Certification, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Certification}" />
              </Border>
              <TextBlock Text="{Binding MetaLine}" Classes="muted" VerticalAlignment="Center" Margin="0,0,14,6" />
              <TextBlock Text="{Binding SeasonSummary}" Classes="muted" VerticalAlignment="Center" Margin="0,0,14,6" />
              <TextBlock Text="{Binding Genres}" Classes="muted" VerticalAlignment="Center" Margin="0,0,0,6" />
            </WrapPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
              <Button Classes="accent" Command="{Binding PlayCommand}" Padding="22,12" Margin="0,0,12,10" IsEnabled="{Binding HasSeasons}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="icon" Text="&#xE768;" FontSize="15" Foreground="{DynamicResource OnAccent}" />
                  <TextBlock Text="{Binding PlayLabel}" FontSize="15" Foreground="{DynamicResource OnAccent}" />
                </StackPanel>
              </Button>
              <Button Classes="soft" Command="{Binding ToggleFavoriteCommand}" Padding="18,12" Margin="0,0,12,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="icon" FontSize="14" Text="{Binding Series.IsFavorite, Converter={x:Static ctl:Conv.HeartGlyph}}" Foreground="{DynamicResource Accent}" />
                  <TextBlock Text="{l:Tr Detail.MyList}" />
                </StackPanel>
              </Button>
              <Button Classes="soft" Command="{Binding OpenTrailerCommand}" IsVisible="{Binding HasTrailer}" Padding="18,12" Margin="0,0,12,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="icon" Text="&#xE714;" FontSize="14" />
                  <TextBlock Text="{l:Tr Ui.BandeAnnonce}" />
                </StackPanel>
              </Button>
            </WrapPanel>
            <TextBlock Text="{Binding Plot}" TextWrapping="Wrap" FontSize="15" LineHeight="24" MaxWidth="860" HorizontalAlignment="Left" MaxLines="7" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="860" HorizontalAlignment="Left" Text="{Binding Director, Converter={x:Static l:Loc.Format}, ConverterParameter=Detail.Creator}"
                       IsVisible="{Binding Director, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Grid>

        <!-- Saisons et épisodes -->
        <StackPanel Spacing="14">
          <TextBlock Classes="h2" Text="{l:Tr Ui.Episodes}" />
          <Arc Classes="spinner" HorizontalAlignment="Left" IsVisible="{Binding IsLoadingDetails}" />
          <TextBlock Classes="muted" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <ListBox Classes="seasons" ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason}" Background="Transparent"
                   IsVisible="{Binding HasSeasons}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:SeasonInfo">
                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ItemsControl ItemsSource="{Binding Episodes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:Episode">
                <Button Classes="cardButton" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                        Command="{ReflectionBinding $parent[UserControl].DataContext.PlayEpisodeCommand}" CommandParameter="{Binding}">
                  <Border Classes="episode">
                    <Grid ColumnDefinitions="248,*,Auto">
                      <Border Width="240" Height="135" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource Placeholder}">
                        <Panel>
                          <TextBlock Text="{Binding Code}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PlaceholderText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <Image img:ImageLoader.Source="{Binding ImageUrl}" img:ImageLoader.DecodeWidth="480" Stretch="UniformToFill" />
                          <Border Width="44" Height="44" CornerRadius="22" Background="#99000000" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Classes="icon" Text="&#xE768;" FontSize="16" Foreground="White" Margin="3,0,0,0" />
                          </Border>
                          <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Success}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                  IsVisible="{Binding IsWatched}">
                            <TextBlock Classes="icon" Text="&#xE73E;" FontSize="12" Foreground="White" />
                          </Border>
                          <ProgressBar Classes="thin" Value="{Binding Progress}" Maximum="100" VerticalAlignment="Bottom" CornerRadius="0" Background="#55000000"
                                       IsVisible="{Binding Progress, Converter={x:Static ctl:Conv.ProgressVisible}}" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="18,4,12,0" Spacing="5" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Text="{Binding Number, Converter={x:Static l:Loc.Format}, ConverterParameter=Detail.EpisodeNumber}" Classes="accent" FontWeight="SemiBold" FontSize="13" />
                          <TextBlock Text="{Binding DurationText}" Classes="faint" FontSize="13" />
                          <TextBlock Text="{Binding AirDate}" Classes="faint" FontSize="13" />
                        </StackPanel>
                        <TextBlock Text="{Binding DisplayTitle}" Classes="h3" FontSize="16" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Plot}" Classes="muted" FontSize="13.5" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" LineHeight="20" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="icon" VerticalAlignment="Center" ToolTip.Tip="{l:Tr Ui.MarquerCommeVuNonVu}"
                              Command="{ReflectionBinding $parent[UserControl].DataContext.ToggleWatchedCommand}" CommandParameter="{Binding}">
                        <TextBlock Classes="icon" Text="&#xE73E;" FontSize="14" />
                      </Button>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Distribution -->
        <StackPanel IsVisible="{Binding HasCast}" Spacing="12">
          <TextBlock Classes="h2" Text="{l:Tr Ui.Distribution}" />
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Cast}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="18" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:CastMember">
                  <StackPanel Width="112" Spacing="6">
                    <Border Width="96" Height="96" CornerRadius="48" ClipToBounds="True" Background="{DynamicResource Placeholder}" HorizontalAlignment="Center">
                      <Panel>
                        <TextBlock Text="{Binding Name, Converter={x:Static ctl:Conv.Initials}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PlaceholderText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image img:ImageLoader.Source="{Binding PhotoUrl}" img:ImageLoader.DecodeWidth="200" Stretch="UniformToFill" />
                      </Panel>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock Text="{Binding Character}" Classes="faint" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Panel>
</UserControl>
