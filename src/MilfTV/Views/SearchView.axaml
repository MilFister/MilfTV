<UserControl xmlns:l="using:MilfTV.Localization"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MilfTV.ViewModels"
             xmlns:v="using:MilfTV.Views"
             x:Class="MilfTV.Views.SearchView"
             x:DataType="vm:SearchViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,4,28,32" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
      <StackPanel Spacing="2">
        <TextBlock Classes="h1" Text="{l:Tr Ui.Recherche}" />
        <TextBlock Classes="muted" Text="{Binding Summary}" />
      </StackPanel>
      <Arc Classes="spinner" HorizontalAlignment="Left" IsVisible="{Binding IsBusy}" />
      <Border Classes="card" Padding="10">
        <v:SearchResultsList DataContext="{Binding Results}" Compact="False" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
