<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:MilfTV.Localization"
             xmlns:vm="using:MilfTV.ViewModels"
             xmlns:ctl="using:MilfTV.Controls"
             x:Class="MilfTV.Views.ProfileEditorView"
             x:DataType="vm:ProfileEditorViewModel">
  <UserControl.Styles>
    <Style Selector="Button.avatarChoice">
      <Setter Property="Padding" Value="2" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.avatarChoice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.avatarChoice.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.avatarEdit">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="48" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.avatarEdit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>
  <Border Classes="card" Width="480" Padding="28" Background="{DynamicResource SurfaceRaised}" BoxShadow="0 24 60 0 #66000000">
    <StackPanel Spacing="18">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="h2" Text="{Binding DialogTitle}" />
        <Button Grid.Column="1" Classes="icon" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}">
          <TextBlock Classes="icon" Text="&#xE711;" FontSize="12" />
        </Button>
      </Grid>

      <!-- Avatar : un clic ouvre la galerie (émojis, image importée, initiale) -->
      <StackPanel HorizontalAlignment="Center" Spacing="4">
        <Button x:Name="AvatarButton" Classes="avatarEdit" HorizontalAlignment="Center" ToolTip.Tip="{l:Tr Profile.ChangeAvatar}">
          <Panel Width="96" Height="96">
            <ctl:ProfileAvatar Width="96" Height="96" ProfileColor="{Binding Color}" Initial="{Binding Initial}" Avatar="{Binding Avatar}" />
            <Border Width="30" Height="30" CornerRadius="15" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
              <TextBlock Classes="icon" Text="&#xE70F;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Panel>
          <Button.Flyout>
            <Flyout Placement="Bottom">
              <StackPanel Width="392" Spacing="12" Margin="4">
                <TextBlock Text="{l:Tr Profile.AvatarTitle}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding AvatarChoices}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="4" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AvatarChoice">
                      <Button Classes="avatarChoice" Classes.selected="{Binding IsSelected}"
                              Command="{Binding Owner.PickAvatarCommand}" CommandParameter="{Binding}">
                        <ctl:ProfileAvatar Width="40" Height="40" Avatar="{Binding Value}"
                                           ProfileColor="{Binding Owner.Color}" Initial="{Binding Owner.Initial}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="soft" Click="OnPickAvatarImage" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon" Text="&#xE91B;" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{l:Tr Profile.PickImage}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Classes="caption" Text="{l:Tr Profile.PickImageHint}" TextWrapping="Wrap" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Classes="flat" HorizontalAlignment="Center" Padding="10,3" FontSize="12.5" Content="{l:Tr Profile.ChangeAvatar}" Click="OnChangeAvatarClick" />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Classes="caption" Text="{l:Tr Profile.Name}" />
        <TextBox Text="{Binding Name}" MaxLength="24" />
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Classes="caption" Text="{l:Tr Profile.Color}" />
        <ItemsControl ItemsSource="{Binding Colors}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel ItemSpacing="10" LineSpacing="10" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ColorChoice">
              <Button Width="36" Height="36" CornerRadius="18" Padding="0" BorderThickness="0"
                      Background="{Binding Hex, Converter={x:Static ctl:Conv.HexBrush}}"
                      Command="{ReflectionBinding $parent[UserControl].DataContext.PickColorCommand}" CommandParameter="{Binding}">
                <TextBlock Classes="icon" Text="&#xE73E;" FontSize="14" Foreground="White" IsVisible="{Binding IsSelected}" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="{l:Tr Profile.KidMode}" FontWeight="SemiBold" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:Tr Profile.KidModeHint}" />
          <Grid ColumnDefinitions="Auto,*" Margin="0,6,0,0" IsVisible="{Binding IsKid}">
            <TextBlock Classes="icon" Text="&#xE72E;" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,2,7,0" />
            <TextBlock Grid.Column="1" Classes="caption" TextWrapping="Wrap" Text="{l:Tr Profile.KidLockHint}" />
          </Grid>
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsKid}" OnContent="" OffContent="" VerticalAlignment="Center" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="{l:Tr Profile.PasswordProtect}" FontWeight="SemiBold" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:Tr Profile.PasswordHint}" />
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding UsePassword}" OnContent="" OffContent="" VerticalAlignment="Center" />
      </Grid>
      <Grid ColumnDefinitions="*,12,*" IsVisible="{Binding UsePassword}">
        <TextBox Text="{Binding NewPassword}" PasswordChar="●" Watermark="{l:Tr Profile.NewPassword}" />
        <TextBox Grid.Column="2" Text="{Binding ConfirmPassword}" PasswordChar="●" Watermark="{l:Tr Profile.ConfirmPassword}" />
      </Grid>
      <TextBlock Classes="caption" Text="{l:Tr Profile.PasswordKeep}" IsVisible="{Binding HadPassword}" />

      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Button Classes="danger" Content="{l:Tr Common.Delete}" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" />
        <Button Grid.Column="2" Classes="flat" Content="{l:Tr Ui.Annuler}" Command="{Binding CancelCommand}" Margin="0,0,8,0" IsVisible="{Binding CanCancel}" />
        <Button Grid.Column="3" Classes="accent" Content="{l:Tr Ui.Enregistrer}" Command="{Binding SaveCommand}" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
