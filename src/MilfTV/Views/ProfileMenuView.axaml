<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:MilfTV.Localization"
             xmlns:vm="using:MilfTV.ViewModels"
             xmlns:data="using:MilfTV.Data"
             xmlns:ctl="using:MilfTV.Controls"
             x:Class="MilfTV.Views.ProfileMenuView"
             x:DataType="vm:ProfileMenuViewModel"
             Width="300">
  <!-- Menu du profil actif, ouvert depuis le profil en bas à gauche de la barre latérale. -->
  <UserControl.Styles>
    <Style Selector="Button.row">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.row TextBlock.icon">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Button.row.logout TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    </Style>
    <Style Selector="Border.menuSep">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="6,6" />
      <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
    </Style>
    <Style Selector="Button.avatarEdit">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="26" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.avatarEdit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.avatarEdit Border#EditBadge">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.avatarEdit:pointerover Border#EditBadge">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="1" Margin="2">
    <!-- En-tête : le profil actif -->
    <Grid ColumnDefinitions="Auto,*" Margin="8,8,8,6">
      <Button Classes="avatarEdit" Command="{Binding EditAvatarCommand}" ToolTip.Tip="{l:Tr Profile.ChangeAvatar}">
        <Panel Width="52" Height="52">
          <ctl:ProfileAvatar Width="52" Height="52" Profile="{Binding Current}" />
          <Border x:Name="EditBadge" Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
            <TextBlock Classes="icon" Text="&#xE70F;" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Panel>
      </Button>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="4">
        <TextBlock Text="{Binding Current.Name, FallbackValue=''}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <WrapPanel ItemSpacing="8" LineSpacing="4">
          <Border Classes="badge accent" IsVisible="{Binding IsKid}">
            <TextBlock Text="{l:Tr Profile.Kid}" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasPassword}">
            <TextBlock Classes="icon" Text="&#xE72E;" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
            <TextBlock Classes="caption" Text="{l:Tr Menu.Protected}" VerticalAlignment="Center" />
          </StackPanel>
        </WrapPanel>
      </StackPanel>
    </Grid>

    <Border Classes="menuSep" />
    <Button Classes="flat row" Command="{Binding EditCommand}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Classes="icon" Text="&#xE70F;" />
        <TextBlock Text="{l:Tr Menu.EditProfile}" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
    <Button Classes="flat row" Command="{Binding EditAvatarCommand}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Classes="icon" Text="&#xE77B;" />
        <TextBlock Text="{l:Tr Profile.ChangeAvatar}" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
    <Button Classes="flat row" Command="{Binding SettingsCommand}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Classes="icon" Text="&#xE713;" />
        <TextBlock Text="{l:Tr Menu.ProfileSettings}" VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <Border Classes="menuSep" />
    <TextBlock Classes="caption" FontWeight="SemiBold" Text="{l:Tr Profile.Switch}" Margin="10,4,0,4" IsVisible="{Binding HasOthers}" />
    <ItemsControl ItemsSource="{Binding Others}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="data:UserProfile">
          <Button Classes="flat row" Padding="8,6" Command="{ReflectionBinding $parent[UserControl].DataContext.SwitchCommand}" CommandParameter="{Binding}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <ctl:ProfileAvatar Width="30" Height="30" Profile="{Binding}" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="12,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border Classes="badge accent" IsVisible="{Binding IsKid}">
                  <TextBlock Text="{l:Tr Profile.Kid}" />
                </Border>
                <TextBlock Classes="icon" Text="&#xE72E;" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                           IsVisible="{Binding HasPassword}" />
              </StackPanel>
            </Grid>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Classes="flat row" Command="{Binding AddCommand}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Classes="icon" Text="&#xE710;" />
        <TextBlock Text="{l:Tr Profile.Add}" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
    <Button Classes="flat row" Command="{Binding ManageCommand}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Classes="icon" Text="&#xE716;" />
        <TextBlock Text="{l:Tr Profile.Manage}" VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <Border Classes="menuSep" />
    <Button Classes="flat row logout" Command="{Binding LogOutCommand}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Classes="icon" Text="&#xF3B1;" />
        <TextBlock Text="{l:Tr Menu.LogOut}" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
  </StackPanel>
</UserControl>
