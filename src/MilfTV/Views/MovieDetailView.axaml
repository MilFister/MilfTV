<UserControl xmlns:l="using:MilfTV.Localization"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MilfTV.ViewModels"
             xmlns:core="using:MilfTV.Core"
             xmlns:ctl="using:MilfTV.Controls"
             xmlns:img="using:MilfTV.Images"
             xmlns:v="using:MilfTV.Views"
             x:Class="MilfTV.Views.MovieDetailView"
             x:DataType="vm:MovieDetailViewModel">
  <Panel>
    <!-- Fond -->
    <Panel VerticalAlignment="Top" Height="560" ClipToBounds="True">
      <Image img:ImageLoader.Source="{Binding Poster}" img:ImageLoader.DecodeWidth="300" Stretch="UniformToFill" Opacity="0.35">
        <Image.Effect><BlurEffect Radius="60" /></Image.Effect>
      </Image>
      <Image img:ImageLoader.Source="{Binding Backdrop}" img:ImageLoader.DecodeWidth="1600" Stretch="UniformToFill" Opacity="0.6" />
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="{DynamicResource AppBgColor}" Offset="1" />
            <GradientStop Color="{DynamicResource AppBgClearColor}" Offset="0.2" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="{DynamicResource AppBgColor}" Offset="0" />
            <GradientStop Color="{DynamicResource AppBgClearColor}" Offset="0.7" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Panel>

    <ScrollViewer x:Name="MainScroll">
      <StackPanel Margin="40,8,40,40" Spacing="30">
        <Button Classes="flat" Command="{Binding BackCommand}" HorizontalAlignment="Left" Padding="10,6" Margin="-10,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon" Text="&#xE72B;" FontSize="13" />
            <TextBlock Text="{l:Tr Ui.Retour}" />
          </StackPanel>
        </Button>

        <Grid ColumnDefinitions="250,*">
          <Border Width="250" Height="375" CornerRadius="18" ClipToBounds="True" Background="{DynamicResource Placeholder}" BoxShadow="0 24 60 0 #77000000" VerticalAlignment="Top">
            <Panel>
              <TextBlock Text="{Binding Movie.Initials}" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource PlaceholderText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image img:ImageLoader.Source="{Binding Poster}" img:ImageLoader.DecodeWidth="500" Stretch="UniformToFill" />
            </Panel>
          </Border>
          <StackPanel Grid.Column="1" Margin="40,6,0,0" Spacing="14">
            <TextBlock Classes="display" Text="{Binding DisplayTitle}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding OriginalTitle}" FontStyle="Italic" IsVisible="{Binding OriginalTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <WrapPanel Orientation="Horizontal">
              <Border Classes="badge" Background="#33FFD24D" Margin="0,0,10,6" IsVisible="{Binding RatingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding RatingText, StringFormat='★ {0}'}" Foreground="#FFC43D" />
              </Border>
              <Border Classes="badge" Margin="0,0,10,6" IsVisible="{Binding Certification, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Certification}" />
              </Border>
              <TextBlock Text="{Binding MetaLine}" Classes="muted" VerticalAlignment="Center" Margin="0,0,14,6" />
              <TextBlock Text="{Binding Genres}" Classes="muted" VerticalAlignment="Center" Margin="0,0,0,6" />
            </WrapPanel>
            <TextBlock Text="{Binding Tagline}" FontStyle="Italic" Classes="muted" FontSize="15" IsVisible="{Binding Tagline, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
              <Button Classes="accent" Command="{Binding PlayCommand}" Padding="22,12" Margin="0,0,12,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="icon" Text="&#xE768;" FontSize="15" Foreground="{DynamicResource OnAccent}" />
                  <TextBlock Text="{Binding PlayLabel}" FontSize="15" Foreground="{DynamicResource OnAccent}" />
                </StackPanel>
              </Button>
              <Button Classes="soft" Command="{Binding RestartCommand}" IsVisible="{Binding CanRestart}" Padding="18,12" Margin="0,0,12,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="icon" Text="&#xE72C;" FontSize="14" />
                  <TextBlock Text="{l:Tr Ui.DepuisLeDebut}" />
                </StackPanel>
              </Button>
              <Button Classes="soft" Command="{Binding ToggleFavoriteCommand}" Padding="18,12" Margin="0,0,12,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="icon" FontSize="14" Text="{Binding Movie.IsFavorite, Converter={x:Static ctl:Conv.HeartGlyph}}" Foreground="{DynamicResource Accent}" />
                  <TextBlock Text="{l:Tr Detail.MyList}" />
                </StackPanel>
              </Button>
              <Button Classes="soft" Command="{Binding OpenTrailerCommand}" IsVisible="{Binding HasTrailer}" Padding="18,12" Margin="0,0,12,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="icon" Text="&#xE714;" FontSize="14" />
                  <TextBlock Text="{l:Tr Ui.BandeAnnonce}" />
                </StackPanel>
              </Button>
              <Button Classes="soft" Command="{Binding MarkWatchedCommand}" Padding="18,12" Margin="0,0,12,10" ToolTip.Tip="{l:Tr Ui.MarquerCommeVu}">
                <TextBlock Classes="icon" Text="&#xE73E;" FontSize="14" />
              </Button>
            </WrapPanel>
            <ProgressBar Classes="thin" Width="320" HorizontalAlignment="Left" Value="{Binding ResumeProgress}" Maximum="100"
                         IsVisible="{Binding CanRestart}" />

            <TextBlock Text="{Binding Plot}" TextWrapping="Wrap" FontSize="15" LineHeight="24" MaxWidth="860" HorizontalAlignment="Left"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Classes="muted" Text="{Binding Director, Converter={x:Static l:Loc.Format}, ConverterParameter=Detail.Director}" IsVisible="{Binding Director, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Arc Classes="spinner small" HorizontalAlignment="Left" IsVisible="{Binding IsLoadingDetails}" />
          </StackPanel>
        </Grid>

        <!-- Distribution -->
        <StackPanel IsVisible="{Binding HasCast}" Spacing="12">
          <TextBlock Classes="h2" Text="{l:Tr Ui.Distribution}" />
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Cast}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="18" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:CastMember">
                  <StackPanel Width="112" Spacing="6">
                    <Border Width="96" Height="96" CornerRadius="48" ClipToBounds="True" Background="{DynamicResource Placeholder}" HorizontalAlignment="Center">
                      <Panel>
                        <TextBlock Text="{Binding Name, Converter={x:Static ctl:Conv.Initials}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PlaceholderText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image img:ImageLoader.Source="{Binding PhotoUrl}" img:ImageLoader.DecodeWidth="200" Stretch="UniformToFill" />
                      </Panel>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock Text="{Binding Character}" Classes="faint" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <!-- Même catégorie -->
        <StackPanel IsVisible="{Binding HasSimilar}" Spacing="12">
          <TextBlock Classes="h2" Text="{l:Tr Ui.DansLaMemeCategorie}" />
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="6,6,6,12" Margin="-6,0">
            <ItemsControl ItemsSource="{Binding Similar}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="18" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:Movie">
                  <Button Classes="cardButton" Width="156" Command="{ReflectionBinding $parent[UserControl].DataContext.OpenSimilarCommand}" CommandParameter="{Binding}">
                    <v:PosterCard />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Panel>
</UserControl>
