<UserControl xmlns:l="using:MilfTV.Localization"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MilfTV.ViewModels"
             xmlns:core="using:MilfTV.Core"
             xmlns:ctl="using:MilfTV.Controls"
             x:Class="MilfTV.Views.GuideView"
             x:DataType="vm:GuideViewModel">
  <DockPanel Margin="16,4,16,16">
    <!-- En-tête -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="4,4,0,14">
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Classes="h1" Text="{l:Tr Ui.GuideTv}" />
        <TextBlock Classes="muted" Text="{Binding Lib.EpgStatus, FallbackValue=''}" FontSize="12.5" />
      </StackPanel>
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="24,0" VerticalAlignment="Center">
        <ListBox ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay}" SelectionMode="AlwaysSelected" Background="Transparent">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="14,7" />
              <Setter Property="CornerRadius" Value="18" />
              <Setter Property="Background" Value="{DynamicResource Surface}" />
              <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="CornerRadius" Value="18" />
            </Style>
            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
            </Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DayOption">
              <TextBlock Text="{Binding Label}" FontWeight="Medium" FontSize="13" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Width="240">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="core:Category">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Classes="soft" Command="{Binding NowCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource Live}" />
            <TextBlock Text="{l:Tr Ui.Maintenant}" />
          </StackPanel>
        </Button>
        <Button Classes="icon" Command="{Binding RefreshEpgCommand}" ToolTip.Tip="{l:Tr Ui.RechargerLeGuideTv}">
          <TextBlock Classes="icon" Text="&#xE72C;" FontSize="14" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Détail du programme sélectionné -->
    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,14,0,0" Padding="20,16" IsVisible="{Binding HasSelection}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="badge live" IsVisible="{Binding SelectedIsLive}"><TextBlock Text="{l:Tr Ui.EnDirect}" /></Border>
            <TextBlock Classes="caption" VerticalAlignment="Center">
              <TextBlock.Text>
                <MultiBinding StringFormat="{}{0}  ·  {1}">
                  <Binding Path="SelectedProgramChannel.Name" />
                  <Binding Path="SelectedWhen" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>
          <TextBlock Classes="h2" Text="{Binding SelectedProgram.Title}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding SelectedProgram.Description}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding SelectedProgram.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" MaxWidth="1000" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="20,0,0,0">
          <Button Classes="accent" Command="{Binding WatchCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="icon" Text="&#xE768;" FontSize="14" Foreground="{DynamicResource OnAccent}" />
              <TextBlock Text="{l:Tr Ui.RegarderLaChaine}" Foreground="{DynamicResource OnAccent}" />
            </StackPanel>
          </Button>
          <Button Classes="soft" Command="{Binding RecordCommand}" IsVisible="{Binding SelectedCanRecord}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Ellipse Width="10" Height="10" Fill="{DynamicResource Live}" />
              <TextBlock Text="{l:Tr Guide.Record}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border CornerRadius="16" ClipToBounds="True" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
      <ctl:EpgGrid x:Name="Grid" Source="{Binding}" SelectedProgram="{Binding SelectedProgram}" ScrollToNowRequest="{Binding ScrollToNowRequest}" />
    </Border>
  </DockPanel>
</UserControl>
