<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:MilfTV.Localization"
             xmlns:vm="using:MilfTV.ViewModels"
             xmlns:ctl="using:MilfTV.Controls"
             x:Class="MilfTV.Views.PasswordDialogView"
             x:DataType="vm:PasswordDialogViewModel">
  <Border Classes="card" Width="380" Padding="28" Background="{DynamicResource SurfaceRaised}" BoxShadow="0 24 60 0 #66000000">
    <StackPanel Spacing="16">
      <ctl:ProfileAvatar Width="72" Height="72" HorizontalAlignment="Center" Profile="{Binding Profile}" />
      <TextBlock Classes="h3" FontSize="16" Text="{Binding Prompt}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
      <TextBox x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="●" Watermark="{l:Tr Profile.NewPassword}" />
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" HorizontalAlignment="Center"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="flat" Content="{l:Tr Ui.Annuler}" Command="{Binding CancelCommand}" />
        <Button Classes="accent" Content="{l:Tr Profile.Unlock}" Command="{Binding ConfirmCommand}" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
