<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- x64 par défaut ; « dotnet publish -r win-arm64 » (build\release.ps1 -Arch arm64) produit la version ARM64. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platforms>x64;ARM64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\milftv.ico')">Assets\milftv.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>MilfTV</AssemblyName>
    <RootNamespace>MilfTV</RootNamespace>
    <Product>MilfTV</Product>
    <Version>1.0.0-beta.2</Version>
    <SelfContained>true</SelfContained>
    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Dépôt des versions pour les mises à jour automatiques (ex. https://github.com/compte/MilfTV).
         Vide = pas de mise à jour automatique. build\release.ps1 -UpdateRepo le renseigne aussi. -->
    <UpdateRepo Condition="'$(UpdateRepo)' == ''"></UpdateRepo>
    <!-- Outils de test (scénarios MILFTV_DEV, sources de test) : présents en développement ; build\release.ps1 les
         retire des versions publiées (-p:DevTools=false), sauf avec -DevTools pour tester une publication. -->
    <DevTools Condition="'$(DevTools)' == ''">true</DevTools>
    <DefineConstants Condition="'$(DevTools)' == 'true'">$(DefineConstants);DEVTOOLS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Bibliothèques natives de l'architecture visée : native\ (x64) ou native\arm64\ (ARM64).
         Chargeur Vulkan (Khronos, Apache-2.0) : libmpv en a besoin pour démarrer ; utilisé seulement si Windows n'en a pas. -->
    <None Include="..\..\native\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="'$(RuntimeIdentifier)' != 'win-arm64'" />
    <None Include="..\..\native\vulkan-1.dll" Link="vulkan-1.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="'$(RuntimeIdentifier)' != 'win-arm64'" />
    <None Include="..\..\native\arm64\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="'$(RuntimeIdentifier)' == 'win-arm64'" />
    <None Include="..\..\native\arm64\vulkan-1.dll" Link="vulkan-1.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="'$(RuntimeIdentifier)' == 'win-arm64'" />
    <!-- Licences des composants : à côté de l'exécutable (hors fichier unique) pour rester lisibles après installation. -->
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.23" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- WebView2 : seul le contrôleur Core est utilisé ; on retire les DLL WPF / WinForms du paquet
       (évite le conflit WindowsBase MSB3277 et allège l'exécutable). -->
  <Target Name="MilfTVStripWebView2UiAssemblies" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>

</Project>
