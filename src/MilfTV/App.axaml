<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MilfTV"
             x:Class="MilfTV.App"
             Name="MilfTV"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#6A4CF0" />
        <ColorPaletteResources x:Key="Dark" Accent="#7C5CFF" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://MilfTV/Theming/Styles.axaml" />
  </Application.Styles>
</Application>
